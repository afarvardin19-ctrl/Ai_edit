<div class="contacts-box">
  

  <input type="text" id="contactName" placeholder="نام مخاطب">
  <input type="tel" id="contactPhone" placeholder="شماره تلفن">

  <button type="button" onclick="addContact()">➕ افزودن مخاطب</button>

  <div id="contactsList"></div>
